# HubSpot service key token (Bearer). Create at: Development > Keys > Service keys
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Portal ID (visible in the account URL: app.hubspot.com/contacts/{PORTAL_ID}/...)
HUBSPOT_PORTAL_ID=00000000

# Deal pipeline/stage internal IDs (Settings > Objects > Deals > Pipelines, or GET /crm/v3/pipelines/deals)
HUBSPOT_PIPELINE_ID=default
HUBSPOT_STAGE_ID=appointmentscheduled
# ^ example values from a fresh portal's default Sales Pipeline; resolve yours via
#   node src/examples/list-pipelines.js after setting HUBSPOT_ACCESS_TOKEN

# Retry/backoff config for handleHubSpotErrors
HUBSPOT_MAX_RETRIES=3
HUBSPOT_RETRY_BASE_DELAY_MS=500
